{
  "version": 2,
  "name": "hazina-asili",
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ],
  "env": {
    "APP_NAME": "HAZINA ASILI",
    "APP_VERSION": "4.0.0",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "DB_DRIVER": "pgsql",
    "DB_SSL": "true",
    "SESSION_LIFETIME": "3600",
    "RECORDS_PER_PAGE": "15",
    "LOGIN_MAX_ATTEMPTS": "5",
    "LOGIN_LOCKOUT_MINUTES": "15",
    "FORCE_HTTPS": "true",
    "MAX_FILE_SIZE": "5242880",
    "UPLOAD_DIR": "assets/uploads/"
  }
}
